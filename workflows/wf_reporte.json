{
    "id": "Reporte123456789",
    "name": "Weekly Ticket Report",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 17 * * 5"
                        }
                    ]
                }
            },
            "id": "cron-trigger",
            "name": "Schedule Trigger",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                0
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM tickets WHERE fecha >= NOW() - INTERVAL '7 days'",
                "options": {}
            },
            "id": "postgres-select",
            "name": "Postgres",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.4,
            "position": [
                200,
                0
            ],
            "credentials": {
                "postgres": {
                    "id": "LBNB1O2RdYUkGaf0",
                    "name": "Postgres account"
                }
            }
        },
        {
            "parameters": {
                "operation": "toFile",
                "fileFormat": "csv",
                "options": {}
            },
            "id": "csv-converter",
            "name": "Spreadsheet File",
            "type": "n8n-nodes-base.spreadsheetFile",
            "typeVersion": 2,
            "position": [
                400,
                0
            ]
        },
        {
            "parameters": {
                "operation": "write",
                "fileName": "=/data/reporte_semanal_{{ $now.format('yyyy-MM-dd') }}.csv",
                "options": {}
            },
            "id": "file-writer-cron",
            "name": "Read/Write Files from Disk",
            "type": "n8n-nodes-base.readWriteFile",
            "typeVersion": 1,
            "position": [
                600,
                0
            ]
        }
    ],
    "connections": {
        "Schedule Trigger": {
            "main": [
                [
                    {
                        "node": "Postgres",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Postgres": {
            "main": [
                [
                    {
                        "node": "Spreadsheet File",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Spreadsheet File": {
            "main": [
                [
                    {
                        "node": "Read/Write Files from Disk",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": true
}